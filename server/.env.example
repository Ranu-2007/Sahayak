PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/resqlink
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
# Incident clustering bounds (radius in meters; active incident time window in hours).
INCIDENT_CLUSTER_RADIUS_METERS=1000
INCIDENT_CLUSTER_WINDOW_HOURS=72
# Set to the number of trusted reverse proxies in front of Express in production (commonly 1).
TRUST_PROXY_HOPS=0
# Optional. The six weights must be nonnegative and sum to 100.
# MATCH_WEIGHTS_JSON={"skillService":25,"resourceCapacity":20,"availability":20,"distance":15,"reliability":10,"feedback":10}
